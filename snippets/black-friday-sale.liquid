{%- liquid
  if variant.available and variant.compare_at_price > variant.price and product.gift_card? == false
    unless product.type == 'Mattress Topper Bundles' or product.tags contains 'easy-bundle'
      if variant.inventory_management == blank or variant.inventory_quantity > 0
        assign sale_price = variant.compare_at_price | times: 0.8 | round
        if variant.price == sale_price
          echo 'true'
        endif
      endif
    endunless
  endif
-%}

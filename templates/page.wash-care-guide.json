          "type": "title",
          "settings": {
            "title": "<h1>Wash & Care Guide</h1>",
            "title_underline_style": "none"
          }
        },
        "content_hJVVhF": {
          "type": "content",
          "settings": {
            "page": "",
            "text": "<p>A little care goes a long way. &nbsp;Here’s how to keep every Dreamer RV product feeling as good as day one. Visit our FAQs page for more information.</p>",
            "font": "secondary",
            "font_weight": "400"
          }
        },

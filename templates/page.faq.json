    "faq_11": {
      "type": "section-faq",
      "blocks": {
        "q_11_01": {
          "type": "text",
          "settings": {
            "faq_question": "Where can I see Dreamer RV products in person?",
            "icon": "none",
            "header_image_width": 25,
            "faq_answer": "<p>You can visit selected authorised retailers or see us at caravan and camping shows around Australia.</p><p>Visit our <a href=\"/pages/stockists\">Stockists</a> and <a href=\"/pages/exhibitions-shows\">Exhibitions</a> pages for current locations and upcoming show dates.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "q_11_02": {
          "type": "text",
          "settings": {
            "faq_question": "Can I try a topper at a caravan show?",
            "icon": "none",
            "header_image_width": 25,
            "faq_answer": "<p>Yes. Our caravan and camping show displays give you the opportunity to see and feel the products in person and speak with our team.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "q_11_03": {
          "type": "text",
          "settings": {
            "faq_question": "What measurements should I bring to a caravan show?",
            "icon": "none",
            "header_image_width": 25,
            "faq_answer": "<p>Bring your mattress <strong>width and length in millimetres</strong>, including any head-end <strong>bolster</strong> in the total length, along with the <strong>corner profile</strong> at the foot end.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "q_11_04": {
          "type": "text",
          "settings": {
            "faq_question": "Do you offer show specials?",
            "icon": "none",
            "header_image_width": 25,
            "faq_answer": "<p>From time to time, special show offers may be available during selected events. Any current show pricing will be displayed or communicated at the event.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        }
      },
      "block_order": [
        "q_11_01",
        "q_11_02",
        "q_11_03",
        "q_11_04"
      ],

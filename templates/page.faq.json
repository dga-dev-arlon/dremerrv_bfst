    "faq_12": {
      "type": "section-faq",
      "blocks": {
        "q_12_01": {
          "type": "text",
          "settings": {
            "faq_question": "How can I contact Dreamer RV Customer Care?",
            "icon": "none",
            "header_image_width": 25,
            "faq_answer": "<p>You can contact our Australian Customer Care team by email at <a href=\"mailto:customercare@dreamerrv.com.au\">customercare@dreamerrv.com.au</a> or through our <a href=\"/pages/contact\">Contact Us</a> form.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "q_12_02": {
          "type": "text",
          "settings": {
            "faq_question": "Do you offer Customer Care support by phone?",
            "icon": "none",
            "header_image_width": 25,
            "faq_answer": "<p>Our Customer Care support is provided by email so we can keep accurate details of your measurements, order information and any recommendations provided.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        },
        "q_12_03": {
          "type": "text",
          "settings": {
            "faq_question": "What information should I include when asking for sizing advice?",
            "icon": "none",
            "header_image_width": 25,
            "faq_answer": "<p>Please provide:</p><ul><li>Your mattress <strong>width x length in millimetres</strong></li><li>Any <strong>head-end bolster included in the total length</strong></li><li>The <strong>corner profile at the foot end</strong> — rounded, square or cut corner</li><li>Any unusual features that may affect the fit, such as cabinetry, varying widths or an unusual mattress shape</li></ul><p>The more detail you provide, the easier it is for us to recommend the best fit.</p>",
            "page": "",
            "image_width": 465,
            "liquid": "",
            "html": "",
            "show_contact_form": false
          }
        }
      },
      "block_order": [
        "q_12_01",
        "q_12_02",
        "q_12_03"
      ],

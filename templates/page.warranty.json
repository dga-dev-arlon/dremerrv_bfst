{"sections":{"breadcrumbs":{"type":"breadcrumbs","disabled":true,"settings":{"hide_desktop":false,"hide_mobile":false,"enable_share_button":false}},"main-page":{"type":"main-page","blocks":{"title":{"type":"title","settings":{"title_size":"h2"}},"content":{"type":"content","settings":{}}},"block_order":["title","content"],"disabled":true,"settings":{"max_width":980,"content_alignment":"start","text_alignment":"start","spacing_desktop":50,"spacing_mobile":30}},"section_rich_text_Xhjtjr":{"type":"section-rich-text","blocks":{"title_cAHCBX":{"type":"title","settings":{"title":"<h1>Warranty<\/h1>","title_underline_style":"none"}},"content_7WpAxH":{"type":"content","settings":{"page":"","text":"<p>We stand by the quality of our products and want you to feel confident in your Dreamer RV purchase.<\/p><p>All Dreamer RV products are covered by a 2-year warranty against manufacturing faults.<\/p><h3><br\/>Something Not Quite Right With Your Product?<\/h3><p>Whether you’ve just received your product or have been using it for some time, if you notice an issue that you believe may be a manufacturing fault within the 2-year warranty period, please contact our Customer Care team at <a href=\"mailto:customercare@dreamerrv.com.au\"><span style=\"text-decoration:underline\">customercare@dreamerrv.com.au<\/span><\/a>.<\/p><p>To help us assess the issue and find the best possible solution as quickly as possible, please include:<\/p><ul><li>Your name and order number<\/li><li>A brief description of the issue<\/li><li>Clear photos showing the fault<\/li><li>For Wanderluxe™ Mattress Topper claims, a photo of the manufacturing code on the wash\/care label inside the removable cover, where requested<\/li><\/ul><p>Providing clear photos from different angles where relevant will help our team assess the issue more efficiently.<\/p><h3>What Happens Next?<\/h3><p>Once we’ve received your email, our Customer Care team will review the information and photos provided and work with you on the most appropriate solution.<\/p><p><\/p><h3>What Does the Warranty Cover?<\/h3><p>Our warranty covers manufacturing faults that arise within the 2-year warranty period.<\/p><p>Each claim is assessed individually based on the information and photographs provided so we can determine the most appropriate resolution.<\/p><p>For issues relating to change of mind, ordering the wrong size or returning an otherwise suitable product, please refer to our <a href=\"\/policies\/refund-policy\" title=\"Refund Policy\"><span style=\"text-decoration:underline\">Returns Policy.<\/span><\/a><\/p>","font":"secondary","font_weight":"400"}}},"block_order":["title_cAHCBX","content_7WpAxH"],"custom_css":["p,ul,ol,li,h1,h2,h3,h4 {text-align: left;}","h1,h2,h3,h4 {max-width: 640px; margin-left: auto !important; margin-right: auto !important;}","ul,ol {padding-left: 1.25em;}","h3 {margin-top: 32px;}","li {font-family: var(--font-body-light); font-weight: 300;}"],"name":"t:sections.rich_text.presets.name","settings":{"color_palette":"","overlay_opacity":100,"text_position":"align-center text-center","content_width":1280,"height":"xs","enable_custom_height":false,"custom_height":300,"width":"wide","height_mobile":"xs","spacing_desktop":50,"spacing_mobile":0,"fix_zindex":0}},"dreamer_rv_footer_links_BxFmmn":{"type":"dreamer-rv-footer-links","blocks":{"column_4qmT6P":{"type":"column","settings":{"heading":"Shop","link_1_label":"Mattress Toppers","link_1_url":"shopify:\/\/collections\/wanderluxe-caravan-mattress-toppers","link_2_label":"Mattress Protectors","link_2_url":"shopify:\/\/collections\/caravan-mattress-protectors","link_3_label":"Sheets","link_3_url":"shopify:\/\/collections\/sheets","link_4_label":"Home Comfort Range","link_4_url":"shopify:\/\/collections\/home-comfort-range","link_5_label":"Accessories","link_5_url":"shopify:\/\/collections\/accessories","link_6_label":"","link_6_url":""}},"column_zzxRmE":{"type":"column","settings":{"heading":"Explore","link_1_label":"Our Story","link_1_
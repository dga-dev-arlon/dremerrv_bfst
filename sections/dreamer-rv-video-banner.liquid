{%- liquid
  if section.settings.show_link and section.settings.link_text != empty and section.settings.link_url != blank
    assign link = true
  endif

  if section.settings.title != empty or section.settings.text != empty
    assign show_header = true
  elsif link and section.settings.text_alignment == 'start'
    assign show_header = true
  endif

  if section.settings.title != empty or section.settings.text != empty
    assign container_div = true
  endif

  capture title_classes
    echo 'w900 '
    if section.settings.text_alignment == 'center'
      echo ' text-center align-center'
    endif
  endcapture
-%}

{%- if link %}
  {%- capture link -%}
    {%- liquid
      assign button_color = section.settings.button_style | split: ' ' | first
      assign button_style = section.settings.button_style | split: ' ' | last
      assign is_link = false
      if button_style == 'link'
        assign is_link = true
      endif
    -%}
    <p class="class-x link-btn"><a href="{{ section.settings.link_url }}" class="overlay-{{ button_color }} {% if is_link %}inline strong{% elsif button_style == 'inv' %}inv{% endif %}">{% if is_link %}<span>{% endif %}{{ section.settings.link_text }}{% if is_link %}</span>&nbsp;<i aria-hidden="true" class="icon-chevron-right"></i>{% endif %}</a></p>
  {%- endcapture %}
{%- endif -%}

{%- if show_header -%}
  <header
    class="
      cols title-styling
      {% if section.settings.title_underline_style != 'none' %}
        title-underline-none
        {% if section.settings.title_underline_style contains 'accent' %}
          title-underline-accent
        {% elsif section.settings.title_underline_style contains 'gradient' %}
          title-underline-gradient
        {% endif %}
        {% if section.settings.title_underline_style contains 'secondary_font' %}
          title-underline-secondary-font
        {% endif %}
      {% endif %}
    "
  >
    {%- if container_div -%}<div class="{{ title_classes }}">{%- endif -%}
    {%- if section.settings.title != blank -%}
      {{ section.settings.title }}
    {%- endif -%}
    {%- if section.settings.text != empty -%}
      {{ section.settings.text }}
    {%- endif -%}
    {%- if container_div -%}</div>{%- endif -%}
    {%- if link and section.settings.text_alignment == 'start' -%}
      {{ link | replace: 'class-x', 'mobile-hide' }}
    {%- endif -%}
  </header>
{%- endif -%}

{%- liquid
  assign has_mobile_video = false
  if section.settings.video_url_mobile != blank or section.settings.video_mobile != null
    assign has_mobile_video = true
  endif

  assign has_video = false
  if section.settings.video_url != blank or section.settings.video != null
    assign has_video = true
  endif

  assign focal_desktop = section.settings.focal_y_desktop | default: 50
  assign focal_mobile = section.settings.focal_y_mobile | default: 50
-%}

<figure>
  <span class="drv-video-banner">
    <span class="drv-video-banner__source drv-video-banner__source--desktop">
      {%- if section.settings.video_url != blank -%}
        <video
          class="drv-video-banner__el"
          width="1715"
          height="700"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.video != null -%}
        {{ section.settings.video | video_tag: image_size: '1715x700', autoplay: true, loop: true, muted: true, controls: false, class: 'drv-video-banner__el' }}
      {%- else -%}
        <div class="drv-video-banner__placeholder" style="width:100%;aspect-ratio:1715/700;background:#eee;"></div>
      {%- endif -%}
    </span>

    {%- if has_mobile_video -%}
      <span class="drv-video-banner__source drv-video-banner__source--mobile">
        {%- if section.settings.video_url_mobile != blank -%}
          <video
            class="drv-video-banner__el"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
          >
            <source src="{{ section.settings.video_url_mobile }}" type="video/mp4">
          </video>
        {%- else -%}
          {{ section.settings.video_mobile | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'drv-video-banner__el' }}
        {%- endif -%}
      </span>
    {%- endif -%}

    {%- if section.settings.show_sound_toggle and has_video -%}
      <button type="button" class="drv-video-banner__sound" aria-pressed="false" aria-label="Turn sound on">
        <svg class="drv-video-banner__icon drv-video-banner__icon--off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
        <svg class="drv-video-banner__icon drv-video-banner__icon--on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
        <span class="drv-video-banner__sound-label">{{ section.settings.sound_on_label | default: 'Tap for sound' }}</span>
      </button>
    {%- endif -%}
  </span>
</figure>

{%- if has_mobile_video -%}
  <script>
    (function () {
      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      var desktopVideo = section.querySelector('.drv-video-banner__source--desktop video');
      var mobileVideo = section.querySelector('.drv-video-banner__source--mobile video');
      if (!mobileVideo) return;

      var mq = window.matchMedia('(max-width: 47.5em)');

      function sync() {
        if (mq.matches) {
          if (desktopVideo) desktopVideo.pause();
          mobileVideo.play().catch(function () {});
        } else {
          mobileVideo.pause();
          if (desktopVideo) desktopVideo.play().catch(function () {});
        }
      }

      sync();
      if (mq.addEventListener) {
        mq.addEventListener('change', sync);
      } else if (mq.addListener) {
        mq.addListener(sync);
      }
    })();
  </script>
{%- endif -%}

{%- if section.settings.show_sound_toggle and has_video -%}
  <script>
    (function () {
      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;
      var btn = section.querySelector('.drv-video-banner__sound');
      if (!btn) return;
      var label = btn.querySelector('.drv-video-banner__sound-label');
      var videos = section.querySelectorAll('video.drv-video-banner__el');
      var labelOn = {{ section.settings.sound_on_label | default: 'Tap for sound' | json }};
      var labelOff = {{ section.settings.sound_off_label | default: 'Mute' | json }};
      var restartOnFirstUnmute = {{ section.settings.restart_on_sound | json }};
      var soundOn = false;
      var hasUnmuted = false;

      // The video currently showing (desktop or mobile)
      function visibleVideo() {
        for (var i = 0; i < videos.length; i++) {
          if (videos[i].offsetParent !== null) return videos[i];
        }
        return videos[0];
      }

      btn.addEventListener('click', function () {
        soundOn = !soundOn;
        var active = visibleVideo();

        // Only the visible video plays sound; the hidden one stays muted
        for (var i = 0; i < videos.length; i++) {
          videos[i].muted = !(soundOn && videos[i] === active);
        }

        if (soundOn && active) {
          if (restartOnFirstUnmute && !hasUnmuted) active.currentTime = 0;
          hasUnmuted = true;
          active.play().catch(function () {});
        }

        btn.setAttribute('aria-pressed', soundOn ? 'true' : 'false');
        btn.setAttribute('aria-label', soundOn ? 'Mute video' : 'Turn sound on');
        if (label) label.textContent = soundOn ? labelOff : labelOn;
      });

      // If the screen crosses the mobile breakpoint, move the sound to whichever video is now showing
      var mq = window.matchMedia('(max-width: 47.5em)');
      function resync() {
        if (!soundOn) return;
        var active = visibleVideo();
        for (var i = 0; i < videos.length; i++) {
          videos[i].muted = videos[i] !== active;
        }
      }
      if (mq.addEventListener) {
        mq.addEventListener('change', resync);
      } else if (mq.addListener) {
        mq.addListener(resync);
      }
    })();
  </script>
{%- endif -%}

{%- if link and section.settings.text_alignment == 'center' -%}
  {{ link | replace: 'class-x', 'm0 text-center' }}
{%- elsif link and section.settings.text_alignment == 'start' -%}
  {{ link | replace: 'class-x', 'm0 mobile-only' }}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} { z-index: {{ section.settings.fix_zindex }}!important; }
  @media only screen and (min-width: 47.5em) {
    #shopify-section-{{ section.id }} figure { margin-bottom: {{ section.settings.spacing_desktop }}px; }
    {% if section.settings.spacing_desktop < 0 %}
      #shopify-section-{{ section.id }} + *.has-kinetic-text { pointer-events: none; }
    {% endif %}
  }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} >*:nth-last-child(2) { margin-bottom: {{ section.settings.spacing_mobile }}px; }
    {% if section.settings.spacing_mobile < 0 %}
      #shopify-section-{{ section.id }} + *.has-kinetic-text { pointer-events: none; }
    {% endif %}
  }
  #shopify-section-{{ section.id }} {
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ section.id }} > header {
    position: static !important;
    top: auto !important;
    left: auto !important;
    transform: none !important;
    order: 1;
  }
  #shopify-section-{{ section.id }} p.link-btn {
    position: static !important;
    top: auto !important;
    left: auto !important;
    transform: none !important;
    order: 2;
    margin: 24px 0 40px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} > figure {
    order: 3;
  }
  #shopify-section-{{ section.id }} > header .w900 > *:first-child {
    margin: 0 0 24px !important;
  }
  #shopify-section-{{ section.id }} > header .w900 > *:not(:first-child) {
    margin: 0 !important;
  }
  #shopify-section-{{ section.id }} > p.link-btn {
    margin-bottom: 64px !important;
  }

  /* Video banner — fills the same box the image-comparison slider used */
  #shopify-section-{{ section.id }} .drv-video-banner {
    display: block;
    position: relative;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .drv-video-banner__el {
    display: block;
    width: 100%;
    height: auto;
    {%- if section.settings.video_shape == 'natural' %}
    aspect-ratio: auto;
    {%- else %}
    aspect-ratio: 1715 / 700;
    {%- endif %}
    object-fit: cover;
    /* Focal point — lower % keeps more of the top of the video in frame */
    object-position: 50% {{ focal_desktop }}%;
  }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} .drv-video-banner__el {
      object-position: 50% {{ focal_mobile }}%;
    }
  }

  /* Sound toggle */
  #shopify-section-{{ section.id }} .drv-video-banner__sound {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 10px 16px;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font: inherit;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  #shopify-section-{{ section.id }} .drv-video-banner__sound:hover {
    background: rgba(0, 0, 0, 0.8);
  }
  #shopify-section-{{ section.id }} .drv-video-banner__sound:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  #shopify-section-{{ section.id }} .drv-video-banner__icon { display: block; flex: none; }
  #shopify-section-{{ section.id }} .drv-video-banner__sound .drv-video-banner__icon--on { display: none; }
  #shopify-section-{{ section.id }} .drv-video-banner__sound[aria-pressed="true"] .drv-video-banner__icon--on { display: block; }
  #shopify-section-{{ section.id }} .drv-video-banner__sound[aria-pressed="true"] .drv-video-banner__icon--off { display: none; }
  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} .drv-video-banner__sound {
      right: 12px;
      bottom: 12px;
      padding: 8px 12px;
      font-size: 13px;
    }
  }

  {%- if has_mobile_video %}
    /* Separate mobile-cropped video — swap at the same breakpoint the theme uses elsewhere */
    #shopify-section-{{ section.id }} .drv-video-banner__source--mobile { display: none; }
    @media only screen and (max-width: 47.5em) {
      #shopify-section-{{ section.id }} .drv-video-banner__source--desktop { display: none; }
      #shopify-section-{{ section.id }} .drv-video-banner__source--mobile { display: block; }
      #shopify-section-{{ section.id }} .drv-video-banner__source--mobile .drv-video-banner__el {
        aspect-ratio: auto;
      }
    }
  {%- endif %}
</style>

{% schema %}
{
  "name": "Dreamer RV Video Banner",
  "class": "video-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Video — desktop"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (upload)",
      "info": "Upload a landscape video directly. Leave 'Video URL' below empty to use this."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (hosted .mp4)",
      "info": "A direct link to an .mp4 file (e.g. hosted on your CDN). If filled in, this is used instead of the uploaded video above."
    },
    {
      "type": "header",
      "content": "Video — mobile (optional)"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video (upload)",
      "info": "Optional — a separately-cropped video for mobile. Leave both mobile fields empty to just reuse the desktop video on mobile."
    },
    {
      "type": "url",
      "id": "video_url_mobile",
      "label": "Mobile video URL (hosted .mp4)",
      "info": "A direct link to an .mp4 file for mobile. If filled in, this is used instead of the uploaded mobile video above."
    },
    {
      "type": "header",
      "content": "Video framing"
    },
    {
      "type": "select",
      "id": "video_shape",
      "label": "Video shape",
      "options": [
        { "value": "banner", "label": "Wide banner (crops top and bottom)" },
        { "value": "natural", "label": "Video's own shape (no cropping)" }
      ],
      "default": "banner"
    },
    {
      "type": "range",
      "id": "focal_y_desktop",
      "label": "Vertical focal point — desktop",
      "info": "Only applies to the wide banner. Lower keeps more of the top of the video in frame (0% = top, 50% = centre).",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "focal_y_mobile",
      "label": "Vertical focal point — mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Sound"
    },
    {
      "type": "paragraph",
      "content": "Browsers only autoplay videos with the sound muted. The sound button lets visitors turn it on."
    },
    {
      "type": "checkbox",
      "id": "show_sound_toggle",
      "label": "Show sound button",
      "default": true
    },
    {
      "type": "text",
      "id": "sound_on_label",
      "label": "Button label (muted)",
      "default": "Tap for sound",
      "visible_if": "{{ section.settings.show_sound_toggle }}"
    },
    {
      "type": "text",
      "id": "sound_off_label",
      "label": "Button label (sound on)",
      "default": "Mute",
      "visible_if": "{{ section.settings.show_sound_toggle }}"
    },
    {
      "type": "checkbox",
      "id": "restart_on_sound",
      "label": "Restart video from the beginning when sound is first turned on",
      "default": true,
      "visible_if": "{{ section.settings.show_sound_toggle }}"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<h2>Video banner</h2>"
    },
    {
      "type": "select",
      "id": "title_underline_style",
      "label": "Title underline style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "secondary_font", "label": "Secondary font", "group": "Fonts" },
        { "value": "secondary_font_accent", "label": "Secondary font (accent)", "group": "Fonts" },
        { "value": "secondary_font_gradient", "label": "Secondary font (gradient)", "group": "Fonts" },
        { "value": "accent", "label": "Accent", "group": "Colors" },
        { "value": "gradient", "label": "Gradient", "group": "Colors" }
      ]
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "id": "text",
      "type": "richtext",
      "label": "Text",
      "default": "<p>Share information and details about this video</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "id": "show_link",
      "type": "checkbox",
      "label": "Show button",
      "default": true
    },
    {
      "id": "link_text",
      "type": "text",
      "label": "Button label",
      "default": "Button",
      "visible_if": "{{ section.settings.show_link }}"
    },
    {
      "id": "link_url",
      "type": "url",
      "label": "Button link",
      "visible_if": "{{ section.settings.show_link }}"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary plain", "label": "Primary", "group": "Plain" },
        { "value": "secondary plain", "label": "Secondary", "group": "Plain" },
        { "value": "tertiary plain", "label": "Tertiary", "group": "Plain" },
        { "value": "primary inv", "label": "Primary", "group": "Inverse" },
        { "value": "secondary inv", "label": "Secondary", "group": "Inverse" },
        { "value": "tertiary inv", "label": "Tertiary", "group": "Inverse" },
        { "value": "primary link", "label": "Primary", "group": "Link" },
        { "value": "secondary link", "label": "Secondary", "group": "Link" },
        { "value": "tertiary link", "label": "Tertiary", "group": "Link" }
      ],
      "default": "primary plain",
      "visible_if": "{{ section.settings.show_link }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "id": "spacing_desktop",
      "type": "range",
      "label": "Spacing desktop",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "id": "spacing_mobile",
      "type": "range",
      "label": "Spacing mobile",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 30
    },
    {
      "id": "fix_zindex",
      "type": "range",
      "label": "Fix z-index",
      "min": 0,
      "max": 25,
      "step": 1,
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Dreamer RV Video Banner",
      "category": "Feature banners"
    }
  ]
}
{% endschema %}

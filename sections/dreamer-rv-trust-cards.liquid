{%- comment -%}
  Dreamer RV - "Trust cards" section
  Eyebrow + heading + subheading, then up to 4 image cards (dark overlay,
  heading + body text over the image), plus an optional "Shop all" button.
  Full-bleed background within the theme's 20px frame, adjustable padding
  top/bottom, per-card image + copy editable as blocks.
{%- endcomment -%}

<section
  class="drv-trust"
  style="
    --drv-trust-bg: {{ section.settings.background_color }};
    --drv-trust-text: {{ section.settings.text_color }};
    --drv-trust-pt: {{ section.settings.padding_top }}px;
    --drv-trust-pb: {{ section.settings.padding_bottom }}px;
    --drv-trust-px: {{ section.settings.frame_padding_sides }}px;
    --drv-trust-card-radius: {{ section.settings.card_border_radius }}px;
    --drv-trust-card-padding: {{ section.settings.card_padding }}px;
    --drv-trust-card-gap: {{ section.settings.card_gap }}px;
    --drv-trust-columns: {{ section.blocks.size }};
    --drv-trust-card-text: {{ section.settings.card_text_color }};
    --drv-trust-overlay: {{ section.settings.overlay_color }};
    --drv-trust-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --drv-trust-button-bg: {{ section.settings.button_bg }};
    --drv-trust-button-text: {{ section.settings.button_text }};
  "
>
  <div class="drv-trust__frame">
    {%- if section.settings.eyebrow_text != blank -%}
      <p class="drv-trust__eyebrow">{{ section.settings.eyebrow_text }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="drv-trust__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="drv-trust__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="drv-trust__cards">
        {%- for block in section.blocks -%}
          {%- assign is_solid = false -%}
          {%- if block.settings.card_style == 'solid' -%}
            {%- assign is_solid = true -%}
          {%- endif -%}
          <div
            class="drv-trust__card{% if is_solid %} drv-trust__card--solid{% endif %}"
            {% if is_solid %}
              style="--drv-trust-card-solid-bg: {{ block.settings.solid_color }}; --drv-trust-card-solid-text: {{ block.settings.solid_text_color }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- unless is_solid -%}
              {%- if block.settings.image != blank -%}
                <img
                  class="drv-trust__card-image"
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 450 }} 450w,
                    {{ block.settings.image | image_url: width: 900 }} 900w,
                    {{ block.settings.image | image_url: width: 1350 }} 1350w
                  "
                  sizes="(min-width: 990px) 33vw, 100vw"
                  alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- endif -%}
              <div class="drv-trust__card-overlay"></div>
            {%- endunless -%}
            <div class="drv-trust__card-content">
              {%- if block.settings.heading != blank -%}
                <p class="drv-trust__card-heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="drv-trust__card-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_button and section.settings.button_label != blank -%}
      <div class="drv-trust__button-wrap">
        <a href="{{ section.settings.button_link | default: '#' }}" class="drv-trust__button">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'dreamer-rv-trust-cards.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Trust cards",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "PROUDLY OWNED AND RUN ON AUSTRALIAN SOIL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From one happy camper to another"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Every email lands with someone who's towed a van, measured a bed and knows exactly what you're describing.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#2F8F86"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card inner padding",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#F9F2E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#424345"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "frame_padding_sides",
      "label": "Side padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "card_style",
          "label": "Card style",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "solid", "label": "Solid colour" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Used when card style is set to Image"
        },
        {
          "type": "color",
          "id": "solid_color",
          "label": "Solid background colour",
          "default": "#FFFBF5",
          "info": "Used when card style is set to Solid colour"
        },
        {
          "type": "color",
          "id": "solid_text_color",
          "label": "Solid card text colour",
          "default": "#424345",
          "info": "Used when card style is set to Solid colour"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "We get it, because we live it"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Body text",
          "default": "Body text goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust cards",
      "blocks": [
        { "type": "card" },
        { "type": "card", "settings": { "card_style": "solid" } },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}

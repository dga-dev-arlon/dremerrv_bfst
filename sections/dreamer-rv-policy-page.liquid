{% comment %}
  Policy-style layout for regular Shopify pages. Page title and body remain
  editable in Online Store > Pages; no legal copy is embedded in the theme.
{% endcomment %}
<article
  class="drv-policy-page shopify-policy__container"
  aria-labelledby="drv-policy-title-{{ section.id }}"
>
  <header class="shopify-policy__title">
    <h1 id="drv-policy-title-{{ section.id }}">{{ page.title | escape }}</h1>
  </header>
  <div class="shopify-policy__body">
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
  {%- if request.design_mode and page.content == blank -%}
    <p class="drv-policy-page__editor-note">Add the supplied Black Friday T&amp;Cs in Online Store &gt; Pages &gt; Black Friday Sale Terms &amp; Conditions. This template displays that page's content.</p>
  {%- endif -%}
</article>

<style>
  #shopify-section-{{ section.id }} .drv-policy-page {
    box-sizing: border-box;
    width: 100%;
    max-width: {{ section.settings.content_width }}px;
    margin: 24px auto 64px;
    padding: 0 20px;
    color: var(--text-color-body, #424345);
    font-family: var(--font-body-light, 'Luxora Grotesk Light', sans-serif);
    font-weight: var(--text-body-light-weight, 300);
    font-size: 16px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .shopify-policy__title {
    margin: 0 0 32px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .shopify-policy__title h1 {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading, 'Bethany Elingston', serif);
    font-size: var(--h1-size, 48px);
    font-weight: 400;
    line-height: 1.2;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .shopify-policy__body { text-align: left; }
  #shopify-section-{{ section.id }} .shopify-policy__body p { margin: 0 0 24px; }
  #shopify-section-{{ section.id }} .shopify-policy__body h2,
  #shopify-section-{{ section.id }} .shopify-policy__body h3 { margin: 32px 0 16px; }
  #shopify-section-{{ section.id }} .shopify-policy__body li > p { margin: 0; }
  #shopify-section-{{ section.id }} .shopify-policy__body li + li { margin-top: 4px; }
  #shopify-section-{{ section.id }} .shopify-policy__body ul,
  #shopify-section-{{ section.id }} .shopify-policy__body ol { padding-left: 1.25em; }
  #shopify-section-{{ section.id }} .shopify-policy__body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .shopify-policy__body a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  #shopify-section-{{ section.id }} .shopify-policy__body img {
    max-width: 100%;
    height: auto;
  }
  #shopify-section-{{ section.id }} .drv-policy-page__editor-note {
    padding: 16px;
    border: 1px dashed currentColor;
    font-size: 14px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .drv-policy-page { margin-top: 24px; margin-bottom: 48px; }
    #shopify-section-{{ section.id }} .shopify-policy__title h1 { font-size: 36px; }
    #shopify-section-{{ section.id }} .shopify-policy__body h2 { font-size: 28px; }
    #shopify-section-{{ section.id }} .shopify-policy__body h3 { font-size: 24px; }
  }
</style>

{% schema %}
{
  "name": "Policy-style page",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Matches the store's policy-page layout. Edit the title and legal content in Online Store > Pages. Use Heading 2 and Heading 3 for subheadings in the page body."
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 600,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 800
    }
  ]
}
{% endschema %}

        { "type": "number", "id": "length_min_cm", "label": "Minimum length (cm)" },
        { "type": "number", "id": "length_max_cm", "label": "Maximum length (cm)" },
        {
          "type": "select",
          "id": "corner_type",
          "label": "Corner type",
          "options": [
            { "value": "rounded", "label": "Rounded" },
            { "value": "square", "label": "Square" },
            { "value": "left-cut", "label": "Left-cut" }
          ],
          "default": "rounded"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RV Size Finder",
      "blocks": [
        { "type": "size", "settings": { "label": "Caravan Queen", "width_min_cm": 150, "width_max_cm": 150, "length_min_cm": 189, "length_max_cm": 189, "corner_type": "rounded" } },
        { "type": "size", "settings": { "label": "Queen Long", "width_min_cm": 150, "width_max_cm": 150, "length_min_cm": 200, "length_max_cm": 200, "corner_type": "rounded" } },
        { "type": "size", "settings": { "label": "Queen Short", "width_min_cm": 150, "width_max_cm": 150, "length_min_cm": 180, "length_max_cm": 180, "corner_type": "rounded" } },
        { "type": "size", "settings": { "label": "Caravan Queen Square", "width_min_cm": 150, "width_max_cm": 150, "length_min_cm": 190, "length_max_cm": 190, "corner_type": "square" } },
        { "type": "size", "settings": { "label": "Double", "width_min_cm": 138, "width_max_cm": 138, "length_min_cm": 182, "length_max_cm": 182, "corner_type": "rounded" } },
        { "type": "size", "settings": { "label": "Double V2", "width_min_cm": 145, "width_max_cm": 145, "length_min_cm": 198, "length_max_cm": 198, "corner_type": "rounded" } },
        { "type": "size", "settings": { "label": "Camper Double", "width_min_cm": 138, "width_max_cm": 138, "length_min_cm": 188, "length_max_cm": 188, "corner_type": "square" } },

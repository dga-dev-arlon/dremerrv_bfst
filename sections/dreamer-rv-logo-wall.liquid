{%- comment -%}
  Sparo Studios - as seen in logo wall
{%- endcomment -%}

<section
  class="drv-logo-wall"
  data-section-id="{{ section.id }}"
  style="
    --drv-logowall-bg: {{ section.settings.background_color }};
    --drv-logowall-text: {{ section.settings.text_color }};
    --drv-logowall-logo-height: {{ section.settings.logo_height }}px;
  "
>
  <div class="drv-logo-wall__inner">
    {%- if section.settings.heading != blank -%}
      <p class="drv-logo-wall__heading">{{ section.settings.heading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="drv-logo-wall__track">
        {%- for block in section.blocks -%}
          {%- if block.type == 'logo' -%}
            <div class="drv-logo-wall__item" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" class="drv-logo-wall__link">{%- endif -%}
                  <img
                    class="drv-logo-wall__logo"
                    srcset="
                      {{ block.settings.logo | image_url: width: 300 }} 300w,
                      {{ block.settings.logo | image_url: width: 600 }} 600w
                    "
                    sizes="200px"
                    src="{{ block.settings.logo | image_url: width: 600 }}"
                    alt="{{ block.settings.logo.alt | default: block.settings.name | escape }}"
                    width="{{ block.settings.logo.width }}"
                    height="{{ block.settings.logo.height }}"
                    loading="lazy"
                  >
                {%- if block.settings.url != blank -%}</a>{%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'dreamer-rv-logo-wall.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Dreamer RV Logo Wall",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen in" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F9F2E8" },
    { "type": "color", "id": "text_color", "label": "Heading colour", "default": "#424345" },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Logo height (desktop)",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" },
        { "type": "text", "id": "name", "label": "Publication name", "info": "Used as image alt text if the image has none" },
        { "type": "url", "id": "url", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dreamer RV Logo Wall",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
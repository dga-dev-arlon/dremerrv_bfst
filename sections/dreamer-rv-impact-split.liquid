{%- comment -%}
  Dreamer RV - Image/text split with icon features and two buttons
  (e.g. "For deeper sleep, and a healthier reef")
  Custom section: repeatable icon+text feature blocks (icon uploaded as an
  image so any icon can be used) and two independently editable buttons -
  not something the theme's built-in Image with text section supports.
{%- endcomment -%}

<section
  class="drv-impact drv-impact--image-{{ section.settings.image_position }}"
  style="
    --drv-imp-bg: {{ section.settings.background_color }};
    --drv-imp-text: {{ section.settings.text_color }};
    --drv-imp-pt: {{ section.settings.padding_top }}px;
    --drv-imp-pb: {{ section.settings.padding_bottom }}px;
    --drv-imp-primary-bg: {{ section.settings.primary_button_bg }};
    --drv-imp-primary-text: {{ section.settings.primary_button_text }};
    --drv-imp-secondary-bg: {{ section.settings.secondary_button_bg }};
    --drv-imp-secondary-text: {{ section.settings.secondary_button_text }};
    --drv-imp-min-height: {{ section.settings.min_height }}px;
  "
>
  <div class="drv-impact__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1400 }}"
        srcset="
          {{ section.settings.image | image_url: width: 700 }} 700w,
          {{ section.settings.image | image_url: width: 1000 }} 1000w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w
        "
        sizes="(min-width: 750px) 50vw, 100vw"
        width="1400"
        height="{{ 1400 | divided_by: section.settings.image.aspect_ratio | default: 1400 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="lazy"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'drv-impact__image drv-impact__image--placeholder' }}
    {%- endif -%}
  </div>

  <div class="drv-impact__content">
    <div class="drv-impact__content-inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="drv-impact__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="drv-impact__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="drv-impact__features">
          {%- for block in section.blocks -%}
            <div class="drv-impact__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <img
                  class="drv-impact__feature-icon"
                  src="{{ block.settings.icon | image_url: width: 60 }}"
                  width="30"
                  height="30"
                  alt=""
                  loading="lazy"
                >
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="drv-impact__feature-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_primary_button or section.settings.show_secondary_button -%}
        <div class="drv-impact__buttons">
          {%- if section.settings.show_primary_button and section.settings.primary_button_label != blank -%}
            <a
              href="{{ section.settings.primary_button_link | default: '#' }}"
              class="drv-impact__button drv-impact__button--primary"
            >
              {{ section.settings.primary_button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.show_secondary_button and section.settings.secondary_button_label != blank -%}
            <a
              href="{{ section.settings.secondary_button_link | default: '#' }}"
              class="drv-impact__button drv-impact__button--secondary"
            >
              {{ section.settings.secondary_button_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{{ 'dreamer-rv-impact-split.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Split section home page",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For deeper sleep, and a healthier reef" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Since launching, $5 from every Wanderluxe Caravan Queen bed topper goes straight to the Great Barrier Reef Foundation, a place plenty of our customers have already pulled up the van to see for themselves.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    { "type": "checkbox", "id": "show_primary_button", "label": "Show primary button", "default": true },
    { "type": "text", "id": "primary_button_label", "label": "Primary button label", "default": "Donate" },
    { "type": "url", "id": "primary_button_link", "label": "Primary button link" },
    { "type": "color", "id": "primary_button_bg", "label": "Primary button background", "default": "#2F8F86" },
    { "type": "color", "id": "primary_button_text", "label": "Primary button text colour", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "show_secondary_button", "label": "Show secondary button", "default": true },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Learn more" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },
    { "type": "color", "id": "secondary_button_bg", "label": "Secondary button background", "default": "#BFE3DB" },
    { "type": "color", "id": "secondary_button_text", "label": "Secondary button text colour", "default": "#2B2621" },
    {
      "type": "header",
      "content": "Section styling"
    },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F9F2E8" },
    { "type": "color", "id": "text_color", "label": "Section text colour", "default": "#2B2621" },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 300,
      "max": 900,
      "step": 8,
      "unit": "px",
      "default": 828
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Feature text", "default": "Feature text goes here" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Split section home page",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Footer panel (logo + tagline + acknowledgement of Country,
  and the newsletter subscribe form)
{%- endcomment -%}

{%- comment -%} DRV: footer now lives in the Footer group. Copies left in templates render nothing. {%- endcomment -%}
{%- unless section.location == 'template' -%}
<section
  class="drv-footer-panel"
  style="
    --drv-fp-bg: {{ section.settings.background_color }};
    --drv-fp-text: {{ section.settings.text_color }};
    --drv-fp-panel-bg: {{ section.settings.panel_background_color }};
    --drv-fp-pt: {{ section.settings.padding_top }}px;
    --drv-fp-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="drv-footer-panel__inner">
    <div class="drv-footer-panel__panel">
      <div class="drv-footer-panel__brand">
        {%- if section.settings.icon != blank -%}
          <img
            class="drv-footer-panel__icon"
            src="{{ section.settings.icon | image_url: width: 800 }}"
            width="560"
            height="{{ 560 | divided_by: section.settings.icon.aspect_ratio }}"
            alt="Dreamer RV"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.acknowledgement != blank -%}
          <div class="drv-footer-panel__acknowledgement">{{ section.settings.acknowledgement }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_newsletter -%}
        <div class="drv-footer-panel__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <p class="drv-footer-panel__newsletter-heading">{{ section.settings.newsletter_heading }}</p>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <p class="drv-footer-panel__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}

          {%- assign drv_footer_newsletter_id = 'drv-footer-newsletter-' | append: section.id -%}
          {%- form 'customer', id: drv_footer_newsletter_id, class: 'drv-footer-panel__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="drv-footer-panel__form-row">
              <label class="drv-footer-panel__visually-hidden" for="drv-footer-first-name-{{ section.id }}">First name</label>
              <input
                type="text"
                id="drv-footer-first-name-{{ section.id }}"
                name="contact[first_name]"
                class="drv-footer-panel__input"
                placeholder="First Name"
              >
            </div>
            <div class="drv-footer-panel__form-row">
              <label class="drv-footer-panel__visually-hidden" for="drv-footer-email-{{ section.id }}">Email</label>
              <input
                type="email"
                id="drv-footer-email-{{ section.id }}"
                name="contact[email]"
                class="drv-footer-panel__input"
                placeholder="Email"
                required
              >
            </div>
            {%- if section.settings.newsletter_consent != blank -%}
              <p class="drv-footer-panel__consent">{{ section.settings.newsletter_consent }}</p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="drv-footer-panel__form-success">Thanks for subscribing!</p>
            {%- endif -%}
            <button type="submit" class="drv-footer-panel__subscribe">
              {{ section.settings.newsletter_button_label | default: 'Subscribe' }}
            </button>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{{ 'dreamer-rv-footer-panel.css' | asset_url | stylesheet_tag }}

{%- endunless -%}

{% schema %}
{
  "name": "Footer panel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    { "type": "image_picker", "id": "icon", "label": "Logo (includes wordmark & tagline)" },
    {
      "type": "richtext",
      "id": "acknowledgement",
      "label": "Acknowledgement of Country",
      "default": "<p>In the spirit of reconciliation, Dreamer RV acknowledges the Traditional Custodians of Country throughout Australia and their connections to land, sea and community. We pay our respects to Elders past, present and emerging and extend that respect to all Aboriginal and Torres Strait Islander people today.</p>"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter form", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Subscribe" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Join our newsletter for new product drops and travel inspiration from the road." },
    { "type": "text", "id": "newsletter_button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "newsletter_consent", "label": "Consent text", "default": "By subscribing you agree to our privacy policy and consent to receive updates from Dreamer RV." },
    {
      "type": "header",
      "content": "Section styling"
    },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F9F2E8" },
    { "type": "color", "id": "text_color", "label": "Section text colour", "default": "#2B2621" },
    { "type": "color", "id": "panel_background_color", "label": "Panel background", "default": "#FFFBF5" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Footer panel"
    }
  ]
}
{% endschema %}
{%- comment -%}
  Sparo Studios - promo bar (rewriting the rules feature strip)
{%- endcomment -%}

<section
  class="drv-promo-bar"
  data-section-id="{{ section.id }}"
  style="
    --drv-promo-bg: {{ section.settings.background_color }};
    --drv-promo-text: {{ section.settings.text_color }};
    --drv-promo-pt: {{ section.settings.padding_top }}px;
    --drv-promo-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="drv-promo-bar__inner">
    {%- if section.settings.heading != blank -%}
      <p class="drv-promo-bar__heading">{{ section.settings.heading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="drv-promo-bar__track">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="drv-promo-bar__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <img
                  class="drv-promo-bar__icon"
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt=""
                  width="38"
                  height="38"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <p class="drv-promo-bar__label">{{ block.settings.label }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    position: relative;
  }

  #shopify-section-{{ section.id }}::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background-color: {{ section.settings.background_color }};
    z-index: -1;
    pointer-events: none;
  }

  @media only screen and (max-width: 47.5em) {
    #shopify-section-{{ section.id }} { margin-top: 0 !important; }
  }
</style>

{{ 'dreamer-rv-promo-bar.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Dreamer RV Promo Bar",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rewriting the rules for caravan bedding" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFBF5" },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#2B2621" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dreamer RV Promo Bar",
      "blocks": [
        { "type": "feature", "settings": { "label": "Daily dispatch" } },
        { "type": "feature", "settings": { "label": "Fast delivery" } },
        { "type": "feature", "settings": { "label": "Aussie owned" } },
        { "type": "feature", "settings": { "label": "2 year warranty" } }
      ]
    }
  ]
}
{% endschema %}

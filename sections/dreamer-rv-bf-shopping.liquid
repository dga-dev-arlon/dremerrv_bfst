{{ 'dreamer-rv-black-friday.css' | asset_url | stylesheet_tag }}

<section class="drv-bf drv-bf-shopping" aria-labelledby="drv-bf-shop-title-{{ section.id }}">
  <div class="drv-bf__shopping-inner">
    <h2 id="drv-bf-shop-title-{{ section.id }}" class="drv-bf__shopping-title">{{ section.settings.heading | escape }}</h2>
    <ul class="drv-bf__cards" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_collection = block.settings.collection
          assign card_image = block.settings.image | default: card_collection.image | default: card_collection.products.first.featured_image
          assign card_url = block.settings.link | default: card_collection.url
          assign card_label = block.settings.label | default: card_collection.title
          assign card_alt = block.settings.image_alt | default: card_image.alt | default: card_label
        -%}
        <li class="drv-bf__card" {{ block.shopify_attributes }}>
          {%- if card_url != blank -%}<a class="drv-bf__card-link" href="{{ card_url }}">{%- else -%}<div class="drv-bf__card-link">{%- endif -%}
            <div class="drv-bf__card-media">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 900 | image_tag: class: 'drv-bf__card-image', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 320px, (min-width: 750px) 30vw, calc(100vw - 64px)', alt: card_alt, loading: 'lazy' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'drv-bf__card-image drv-bf__placeholder' }}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}<span class="drv-bf__card-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
            </div>
            <h3 class="drv-bf__card-heading"><span class="drv-bf__card-button">{{ card_label | escape }}</span></h3>
          {%- if card_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
          {%- if request.design_mode and card_url == blank -%}<p class="drv-bf__editor-note">Choose a collection or link for this card.</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Black Friday shopping",
  "tag": "div",
  "class": "section",
  "max_blocks": 3,
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Black Friday Sale" },
    { "type": "paragraph", "content": "Three shopping cards from mock-up 2.png. Set a custom image to match the reference, or use each collection's image. Leave the bundle badge blank. Add your FAQ section separately below this section." }
  ],
  "blocks": [{
    "type": "collection",
    "name": "Shopping card",
    "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended: landscape 4:3 image, at least 900px wide. Defaults to the collection image." },
      { "type": "text", "id": "image_alt", "label": "Image description", "info": "Describe the product shown. Defaults to the image's alt text or the card label." },
      { "type": "text", "id": "label", "label": "Button text" },
      { "type": "url", "id": "link", "label": "Link override", "info": "Optional. Defaults to the selected collection." },
      { "type": "text", "id": "badge", "label": "Sale badge", "info": "Use 20% OFF for individual products. Leave blank for bundles." }
    ]
  }],
  "presets": [{
    "name": "Black Friday shopping",
    "blocks": [
      { "type": "collection", "settings": { "collection": "wanderluxe-caravan-mattress-toppers", "label": "Shop Mattress Toppers", "badge": "20% OFF" } },
      { "type": "collection", "settings": { "collection": "bundles-1", "label": "Shop Caravan Bundles" } },
      { "type": "collection", "settings": { "collection": "caravan-mattress-protectors", "label": "Shop Mattress Protectors", "badge": "20% OFF" } }
    ]
  }]
}
{% endschema %}
